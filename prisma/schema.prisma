generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Personal best tracker
// ---------------------------------------------------------------------------

enum PersonalBestType {
  EXERCISE
  BODY_METRIC
}

enum PersonalBestUnit {
  REPS
  SECONDS
  MINUTES
  METERS
  KM
  KG
  LB
  COUNT
  CM
  MM
  PERCENT
}

enum PersonalBestDirection {
  HIGHER
  LOWER
  LATEST
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now())

  /// Has the user completed the first-login fitness onboarding (assessment + plan).
  onboardingCompleted Boolean  @default(false)

  /// Onboarding context for the first-time personal trainer flow.
  fitnessGoal     String? @default("general_fitness")
  experienceLevel String? @default("intermediate")
  equipment       String? @default("bodyweight")
  injuries        String?

  personalBests  PersonalBest[]
  attempts       Attempt[]
  achievements   Achievement[]
  trainingPlans  TrainingPlan[]
  workoutSessions WorkoutSession[]
  chatMessages   ChatMessage[]
}

model PersonalBest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      PersonalBestType
  name      String
  unit      PersonalBestUnit
  direction PersonalBestDirection

  /// Current best (or latest, for body metrics) value for this record.
  bestValue  Float
  /// Date the current bestValue was achieved.
  achievedAt DateTime

  /// Optional goal the user is chasing for this record.
  targetValue Float?
  targetDate  DateTime?

  notes    String?
  verified Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts     Attempt[]
  achievements Achievement[]

  @@unique([userId, type, name])
  @@index([userId, type])
}

model Attempt {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalBestId String
  personalBest   PersonalBest @relation(fields: [personalBestId], references: [id], onDelete: Cascade)

  value Float
  date  DateTime
  notes String?
  /// Reps performed at `value` (a weight for kg/lb records), used for e1RM.
  reps Int?
  /// Epley estimate of the one-rep max for this entry, when reps were given.
  estimatedOneRep Float?
  /// True when this attempt is the record's current best.
  isBest Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([personalBestId, date])
  @@index([userId, date])
}

/// Append-only log of every time a record was broken.
/// Deliberately not recomputed: an achievement records what happened at the time.
model Achievement {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalBestId String
  personalBest   PersonalBest @relation(fields: [personalBestId], references: [id], onDelete: Cascade)

  value         Float
  /// Previous best, null for the first entry that established the record.
  previousValue Float?
  date          DateTime
  createdAt     DateTime @default(now())

  @@index([userId, date])
  @@index([personalBestId, date])
}

// ---------------------------------------------------------------------------
// Generated training plan (personal trainer feature)
// ---------------------------------------------------------------------------

model TrainingPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal       String
  experience String
  equipment  String
  injuries   String?

  /// "onboarding" for the first plan, "checkin" for adaptive regenerations.
  source  String @default("onboarding")
  /// Coach's summary of what changed and why (set on check-in updates).
  summary String?

  /// The structured plan the generator produced (JSON).
  planJson String
  /// Rendered HTML shown in the UI.
  planHtml String
  /// Your baseline numbers at the time the plan was generated (JSON).
  baselineJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workout sessions (execute the plan, log what you actually did)
// ---------------------------------------------------------------------------

model WorkoutSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  /// Plan day this session follows, e.g. "Monday" (null for ad-hoc sessions).
  planDay     String?
  sessionType String?
  notes       String?
  /// Set when the session is finished; triggers PB sync.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises SessionExercise[]

  @@index([userId, date])
}

model SessionExercise {
  id        String @id @default(cuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  name        String
  muscleGroup String?
  /// "KG" | "LB" when the exercise is loaded; null for bodyweight/timed work.
  unit        String?
  targetSets  Int?
  repTarget   String?
  rpeTarget   String?
  sortOrder   Int    @default(0)

  sets SetEntry[]

  @@index([sessionId])
}

model SetEntry {
  id                String @id @default(cuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  setNumber Int
  weight    Float?
  reps      Int
  rpe       Float?
  /// Attempt created from this set when the session was completed (best set only).
  attemptId String?

  createdAt DateTime @default(now())

  @@index([sessionExerciseId])
}

// ---------------------------------------------------------------------------
// Coach chat
// ---------------------------------------------------------------------------

model ChatMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    String /// "user" | "assistant"
  content String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
